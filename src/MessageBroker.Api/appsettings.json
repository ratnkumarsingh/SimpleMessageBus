{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BrokerDb": ""
  },
  "Broker": {
    "Database": {
      "DeploySchemaOnStartup": true,
      "CreateDatabase": false
    },
    "DataProtection": {
      "KeysDirectory": ""
    },
    "Bootstrap": {
      "AdminName": "broker-admin",
      "AdminApiKey": ""
    },
    "Dispatcher": {
      "PollIntervalMs": 1000,
      "MaintenanceIntervalSeconds": 5
    },
    "Defaults": {
      "MaxAttempts": 4,
      "LockDurationSeconds": 60,
      "RetryBaseDelaySeconds": 30,
      "RetryMaxDelaySeconds": 900,
      "MaxConcurrentDeliveries": 8
    },
    "Webhooks": {
      "TimeoutSeconds": 30,
      "AllowedHosts": [],
      "RequireHttps": true,
      "CircuitFailureThreshold": 5,
      "CircuitOpenSeconds": 60
    },
    "Limits": {
      "MaxPayloadBytes": 262144,
      "MaxPropertiesBytes": 4096
    },
    "Retention": {
      "CompletedDays": 14,
      "DeadLetterDays": 90
    }
  }
}
