    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NBomber" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MessageBroker.Api\MessageBroker.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseKestrel/StartServer on .NET 9 as well (built into WebApplicationFactory from .NET 10). -->
    <Compile Include="..\Shared\KestrelWebApplicationFactory.cs" Link="Shared\KestrelWebApplicationFactory.cs" />
  </ItemGroup>
</Project>
